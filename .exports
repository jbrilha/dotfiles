eval "$(/opt/homebrew/bin/brew shellenv)"

export PATH="/opt/homebrew/opt/grep/libexec/gnubin:$PATH"
export PATH=/usr/local/bin:$PATH

export EDITOR=nvim
export MANPAGER=bat

export XDG_CONFIG_HOME=$HOME/.config

n ()
{
    # Block nesting of nnn in subshells
    [ "${NNNLVL:-0}" -eq 0 ] || {
        echo "nnn is already running"
        return
    }

    # The behaviour is set to cd on quit (nnn checks if NNN_TMPFILE is set)
    # If NNN_TMPFILE is set to a custom path, it must be exported for nnn to
    # see. To cd on quit only on ^G, remove the "export" and make sure not to
    # use a custom path, i.e. set NNN_TMPFILE *exactly* as follows:
    #      NNN_TMPFILE="${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.lastd"
    export NNN_TMPFILE="${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.lastd"

    # Unmask ^Q (, ^V etc.) (if required, see `stty -a`) to Quit nnn
    # stty start undef
    # stty stop undef
    # stty lwrap undef
    # stty lnext undef

    # The command builtin allows one to alias nnn to n, if desired, without
    # making an infinitely recursive alias
    command nnn -xR "$@"

    [ ! -f "$NNN_TMPFILE" ] || {
        . "$NNN_TMPFILE"
        rm -f -- "$NNN_TMPFILE" > /dev/null
    }
}

export NNN_FIFO=/tmp/nnn.fifo
export NNN_PLUG='p:preview-tui;'

export PATH=$HOME/Library/Python/3.11/bin:$PATH
export PATH=$(go env GOPATH)/bin/:$PATH
export PATH=$(opam var bin):$PATH
export PATH=/opt/homebrew/Caskroom/sqlcl/24.4.2.065.1115/sqlcl/bin:"$PATH"

export FZF_DEFAULT_OPTS_FILE=~/.fzfrc

# export JAVA_HOME=$(/usr/libexec/java_home -v 17)
# export JAVA_HOME=$(/usr/libexec/java_home -v 11)
export JAVA_HOME=$(/usr/libexec/java_home -v 21)
export PATH=$JAVA_HOME/bin:$PATH


export PICO_SDK_PATH=~/pico/pico-sdk/
export FREERTOS_KERNEL_PATH=~/FreeRTOS/FreeRTOS-Kernel/

export PATH="/opt/homebrew/opt/llvm/bin:$PATH"

# need this for esp-idf
export SSL_CERT_FILE=$(python3 -c "import certifi; print(certifi.where())")

export PATH=$HOME/.local/bin:$PATH
export HOMEBREW_NO_PATH_SHADOW_CHECK=1

